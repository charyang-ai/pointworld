+#!/bin/bash
+# Container side. Turns a restored subset of the released H5 data into the WDS layout
+# eval.py reads, keeping the paper's test assignment for the clips that are present.
+#
+#   bash scripts/radeon_prepare_subset.sh droid \
+#     /workspace/data/droid_restored/droid/flows-fs-optimized /workspace/data/droid/wds \
+#     /workspace/data/droid_restored/droid/confidence/expert_confidence-seed=42.h5
+#   bash scripts/radeon_prepare_subset.sh behavior \
+#     /workspace/data/behavior_restored/behavior/flows /workspace/data/behavior/wds
+#
+# DATA_SRC is a checkout of the upstream `data` branch, used unchanged.
+set -euo pipefail
+DOMAIN=${1:?usage: radeon_prepare_subset.sh droid|behavior FLOWS_DIR WDS_DIR [CONFIDENCE_H5]}
+FLOWS=${2:?restored flows dir}
+WDS=${3:?output WDS dir}
+CONFIDENCE=${4:-}
+PY=${PY:-/workspace/venv/bin/python}
+DATA_SRC=${DATA_SRC:-/workspace/data_src}
+HERE=$(cd "$(dirname "$0")" && pwd)
+
+cd "$DATA_SRC"
+"$PY" data_integrity_check.py --input_dir "$FLOWS" --domain "$DOMAIN" \
+  --num_mp_workers 16 --output_file "$FLOWS/integrity_check.json"
+"$PY" "$HERE/make_paper_subset_manifest.py" --domain "$DOMAIN" \
+  --integrity_check_file "$FLOWS/integrity_check.json" \
+  --paper_manifest "manifests/${DOMAIN}_paper_split_manifest.json" \
+  --output_manifest "$FLOWS/paper_subset_manifest.json"
+# Evaluation reads only the test split; keep a sliver of train so convert_wds.py accepts the split.
+"$PY" convert_wds.py --input_dir "$FLOWS" --output_dir "$WDS" --domain "$DOMAIN" \
+  --manifest "$FLOWS/paper_subset_manifest.json" --train_frac 0.02
+if [ -n "$CONFIDENCE" ]; then
+  # Filtered DROID metrics read the released confidence file from the test split.
+  ln -f "$CONFIDENCE" "$WDS/test/expert_confidence-seed=42.h5"
+fi
+ls -la "$WDS/train" "$WDS/test"
diff --git a/scripts/radeon_start_container.sh b/scripts/radeon_start_container.sh
new file mode 100644
index 0000000..13fa73e
--- /dev/null
+++ b/scripts/radeon_start_container.sh
@@ -0,0 +1,38 @@
+#!/bin/bash
+# Host side. Creates the single-GPU container used for the validation run.
+#
+#   bash scripts/radeon_start_container.sh /path/to/workdir [/dev/dri/renderD129]
+#
+# The workdir is mounted at /workspace; clone this repo to <workdir>/src first.
+# Only one render node is passed through, so the container sees exactly one GPU.
+# Find the node for a given GPU with `ls -l /dev/dri/by-path` and `rocm-smi --showbus`.
+# Groups are added by number: the image's /etc/group has no "render" entry.
+# Core dumps are off: a crashed process with HIP initialised dumps tens of GB to the host.
+set -euo pipefail
+HOST_DIR=${1:?usage: radeon_start_container.sh HOST_DIR [RENDER_NODE]}
+RENDER_NODE=${2:-/dev/dri/renderD128}
+NAME=${NAME:-radeon-pointworld}
+IMAGE=${IMAGE:-rocm/pytorch:rocm7.14_ubuntu24.04_py3.12_pytorch_release_2.11.0}
+VIDEO_GID=$(getent group video | cut -d: -f3)
+RENDER_GID=$(getent group render | cut -d: -f3)
+mkdir -p "$HOST_DIR/weights" "$HOST_DIR/data" "$HOST_DIR/results"
+
+docker run -d --name "$NAME" \
+  --entrypoint bash \
+  --device=/dev/kfd \
+  --device="$RENDER_NODE" \
+  --group-add "$VIDEO_GID" \
+  --group-add "$RENDER_GID" \
+  --ipc=host \
+  --shm-size=32g \
+  --ulimit core=0 \
+  --security-opt seccomp=unconfined \
+  -e HIP_VISIBLE_DEVICES=0 \
+  -e ROCR_VISIBLE_DEVICES=0 \
+  -v "$HOST_DIR":/workspace \
+  -w /workspace/src \
+  "$IMAGE" \
+  -lc 'sleep infinity'
+
+docker exec "$NAME" /opt/venv/bin/python -c \
+  'import torch; print("torch", torch.__version__, "hip", torch.version.hip, "devices", torch.cuda.device_count(), torch.cuda.get_device_name(0))'
diff --git a/scripts/rank_droid_shards.py b/scripts/rank_droid_shards.py
new file mode 100644
index 0000000..4c58ad9
--- /dev/null
+++ b/scripts/rank_droid_shards.py
@@ -0,0 +1,35 @@
+"""Rank DROID flow shards by how many paper-split test clips they contain.
+
+_shards_manifest.json comes from nvidia/PointWorld-DROID (droid/flows-fs-optimized/),
+the paper manifest from the upstream data branch (manifests/).
+
+python scripts/rank_droid_shards.py <_shards_manifest.json> <droid_paper_split_manifest.json> [top_k]
+"""
+import collections
+import json
+import sys
+
+shards_path, paper_path = sys.argv[1], sys.argv[2]
+top_k = int(sys.argv[3]) if len(sys.argv) > 3 else 15
+
+shards = json.load(open(shards_path, encoding="utf-8"))["shards"]
+paper = json.load(open(paper_path, encoding="utf-8"))
+
+test_by_uuid = collections.Counter()
+for clip_id in paper["test_clip_keys"]:
+    uuid, _, _clip = clip_id.rpartition("-")
+    test_by_uuid[uuid] += 1
+
+rows = []
+for shard in shards:
+    uuids = [
+        m.rsplit("/", 1)[-1][: -len("_flows.h5")] for m in shard["members"] if m.endswith("_flows.h5")
+    ]
+    n_test = sum(test_by_uuid.get(u, 0) for u in uuids)
+    n_files = sum(1 for u in uuids if test_by_uuid.get(u, 0) > 0)
+    size = sum(p["size_bytes"] for p in shard["parts"])
+    rows.append((n_test, n_files, len(uuids), shard["shard_id"], size))
+
+print(f"paper test clips: {sum(test_by_uuid.values())} in {len(test_by_uuid)} episodes")
+for n_test, n_files, n_members, shard_id, size in sorted(rows, reverse=True)[:top_k]:
+    print(f"{shard_id} test_clips={n_test:4d} episodes_with_test={n_files:3d}/{n_members:3d} {size / 1e9:.2f} GB")
diff --git a/tests/check_sparse_ops.py b/tests/check_sparse_ops.py
new file mode 100644
index 0000000..47881d0
--- /dev/null
+++ b/tests/check_sparse_ops.py
@@ -0,0 +1,162 @@
+"""Check ptv3/sparse_conv.py, ptv3/segment.py and ptv3/varlen_attention.py.
+
+SubMConv3d is compared with spconv 2.3.8's CPU build. spconv only runs Native on CPU,
+so the "native" mode must match it with or without duplicate coordinates, and every
+mode must match it when coordinates are unique.
+
+    PYTHONPATH=/path/to/spconv-cpu python tests/check_sparse_ops.py
+"""
+
+import importlib.util
+import json
+import os
+import sys
+
+if os.environ.get("OMP_NUM_THREADS") != "1":
+    # spconv's CPU scatter-add is not atomic: with repeated coordinates, threads lose updates.
+    os.environ["OMP_NUM_THREADS"] = "1"
+    os.execv(sys.executable, [sys.executable] + sys.argv)
+
+import torch  # noqa: E402
+
+PTV3_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "ptv3")
+
+
+def load(name):
+    # By file path, so the check needs torch and spconv only (ptv3/__init__ pulls in timm, addict).
+    spec = importlib.util.spec_from_file_location(name, os.path.join(PTV3_DIR, f"{name}.py"))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+sparse_conv = load("sparse_conv")
+segment_csr = load("segment").segment_csr
+flash_attn_varlen_qkvpacked_func = load("varlen_attention").flash_attn_varlen_qkvpacked_func
+
+results = []
+
+
+def record(name, value, tol):
+    ok = bool(value <= tol)
+    results.append({"check": name, "max_abs_diff": float(value), "tol": tol, "pass": ok})
+    print(f"{'PASS' if ok else 'FAIL'} {name}: {value:.3e} (tol {tol:.0e})")
+
+
+def random_cloud(n, grid, batch_size, channels, seed):
+    g = torch.Generator().manual_seed(seed)
+    coord = torch.randint(0, grid, (n, 3), generator=g)
+    batch = torch.randint(0, batch_size, (n,), generator=g).sort().values
+    indices = torch.cat([batch[:, None], coord], dim=1).int()
+    feats = torch.randn(n, channels, generator=g)
+    return indices, feats
+
+
+def unique_rows(indices):
+    _, first = torch.unique(indices.long(), dim=0, return_inverse=True)
+    keep = torch.zeros(indices.shape[0], dtype=torch.bool)
+    seen = set()
+    for i, v in enumerate(first.tolist()):
+        if v not in seen:
+            seen.add(v)
+            keep[i] = True
+    return keep
+
+
+def check_subm():
+    import spconv.pytorch as spconv_ref
+
+    torch.manual_seed(0)
+    channels = 24
+    ours = sparse_conv.SubMConv3d(channels, channels, 3, bias=True)
+    torch.nn.init.normal_(ours.bias)
+    ref = spconv_ref.SubMConv3d(channels, channels, 3, bias=True)
+    assert tuple(ref.weight.shape) == tuple(ours.weight.shape), (ref.weight.shape, ours.weight.shape)
+    ref.weight.data.copy_(ours.weight.data)
+    ref.bias.data.copy_(ours.bias.data)
+
+    for label, n, grid in (("unique", 4000, 64), ("duplicates", 6000, 14), ("duplicates", 400, 6)):
+        indices, feats = random_cloud(n, grid, 2, channels, seed=1 if label == "unique" else 2)
+        if label == "unique":
+            keep = unique_rows(indices)
+            indices, feats = indices[keep], feats[keep]
+        dup_frac = 1.0 - torch.unique(indices.long(), dim=0).shape[0] / indices.shape[0]
+        shape = (indices[:, 1:].max(0).values + 96).tolist()
+        x_ref = spconv_ref.SparseConvTensor(feats, indices, shape, 2)
+        y_ref = ref(x_ref).features
+        scale = y_ref.abs().max().item()
+        modes = ("cuda", "cuda_first", "native", "full") if label == "unique" else ("native",)
+        for mode in modes:
+            ours.mode = mode
+            y = ours(sparse_conv.SparseConvTensor(feats, indices, shape, 2)).features
+            record(f"subm[{label}, dup={dup_frac:.2f}] {mode} vs spconv-cpu", (y - y_ref).abs().max().item() / scale, 1e-5)
+        if label == "duplicates":
+            ours.mode = "cuda"
+            y = ours(sparse_conv.SparseConvTensor(feats, indices, shape, 2)).features
+            print(f"info: duplicates make cuda and native differ by {(y - y_ref).abs().max().item() / scale:.3e} (expected > 0)")
+
+
+def check_tap_order():
+    # One point at the centre, one neighbour per tap: tap k must read neighbour k.
+    centre = torch.tensor([5, 5, 5])
+    coords = [centre.tolist()] + [(centre + torch.tensor(o)).tolist() for o in sparse_conv._OFFSETS if o != (0, 0, 0)]
+    indices = torch.tensor([[0] + c for c in coords], dtype=torch.int32)
+    feats = torch.arange(len(coords), dtype=torch.float64)[:, None]
+    conv = sparse_conv.SubMConv3d(1, 27, 3, bias=False).double()
+    with torch.no_grad():
+        conv.weight.zero_()
+        for k in range(27):
+            conv.weight[k].view(27)[k] = 1.0
+    y = conv(sparse_conv.SparseConvTensor(feats, indices, [16, 16, 16], 1)).features[0]
+    expected = []
+    neighbour = 1
+    for o in sparse_conv._OFFSETS:
+        if o == (0, 0, 0):
+            expected.append(0.0)
+        else:
+            expected.append(float(neighbour))
+            neighbour += 1
+    record("subm tap k reads indices + offset_k", (y - torch.tensor(expected, dtype=torch.float64)).abs().max().item(), 0.0)
+
+
+def check_segment():
+    g = torch.Generator().manual_seed(3)
+    counts = torch.randint(1, 9, (200,), generator=g)
+    indptr = torch.cat([torch.zeros(1, dtype=torch.long), counts.cumsum(0)])
+    src = torch.randn(int(indptr[-1]), 16, generator=g, dtype=torch.float64)
+    for reduce in ("sum", "mean", "max", "min"):
+        ref = torch.stack([
+            getattr(src[a:b], {"sum": "sum", "mean": "mean", "max": "amax", "min": "amin"}[reduce])(0)
+            for a, b in zip(indptr[:-1].tolist(), indptr[1:].tolist())
+        ])
+        record(f"segment_csr {reduce}", (segment_csr(src, indptr, reduce) - ref).abs().max().item(), 1e-12)
+
+
+def check_attention(device):
+    g = torch.Generator().manual_seed(4)
+    heads, head_dim, patch = 4, 32, 64
+    lengths = [patch] * 5 + [17] + [patch] * 3 + [40]
+    cu = torch.tensor([0] + lengths).cumsum(0).to(torch.int32)
+    qkv = torch.randn(int(cu[-1]), 3, heads, head_dim, generator=g).to(device)
+    scale = head_dim ** -0.5
+    ref = torch.empty(qkv.shape[0], heads, head_dim, device=device)
+    for a, b in zip(cu[:-1].tolist(), cu[1:].tolist()):
+        q, k, v = qkv[a:b].float().permute(1, 2, 0, 3)
+        attn = torch.softmax((q @ k.transpose(-1, -2)) * scale, dim=-1)
+        ref[a:b] = (attn @ v).transpose(0, 1)
+    out = flash_attn_varlen_qkvpacked_func(qkv, cu.to(device), patch, 0.0, scale)
+    record(f"varlen attention fp32 [{device}]", (out - ref).abs().max().item(), 1e-5)
+    out_bf16 = flash_attn_varlen_qkvpacked_func(qkv.bfloat16(), cu.to(device), patch, 0.0, scale)
+    record(f"varlen attention bf16 [{device}]", (out_bf16.float() - ref).abs().max().item(), 3e-2)
+
+
+if __name__ == "__main__":
+    check_tap_order()
+    check_subm()
+    check_segment()
+    check_attention("cpu")
+    if torch.cuda.is_available():
+        check_attention("cuda")
+    passed = all(r["pass"] for r in results)
+    print(json.dumps({"passed": passed, "results": results}, indent=1))
+    sys.exit(0 if passed else 1)
diff --git a/tests/duplicate_stats.py b/tests/duplicate_stats.py
new file mode 100644
index 0000000..6e02123
--- /dev/null
+++ b/tests/duplicate_stats.py
@@ -0,0 +1,74 @@
+"""Count PTv3 stage-0 points that share a voxel with another point, on real eval batches.
+
+Takes the eval.py arguments and runs the evaluation forward pass with a pre-hook on the
+first PTv3 block, where the SubMConv3d positional encoding sees the raw point cloud.
+The JSON goes to $DUPSTATS_OUT (default duplicate_stats.json).
+
+    DUPSTATS_OUT=duplicate_stats.json python tests/duplicate_stats.py --model_path ... \
+        --domains=droid --data_dirs=... --batch_size=1 --eval_num_batches=-1
+"""
+
+import numba  # noqa: F401  (must load before torch on ROCm, see eval.py)
+
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import torch  # noqa: E402
+
+from arguments import parse_args  # noqa: E402
+from evaluation.tester import Tester  # noqa: E402
+
+rows = []
+
+
+def count(module, inputs):
+    point = inputs[0]
+    indices = point.sparse_conv_feat.indices.long()
+    is_robot = point.is_robot.bool().view(-1)
+    _, voxel, per_voxel = torch.unique(indices, dim=0, return_inverse=True, return_counts=True)
+    shared = per_voxel[voxel] > 1
+    robot_in_voxel = torch.zeros(per_voxel.numel(), dtype=torch.long, device=indices.device)
+    robot_in_voxel.index_add_(0, voxel, is_robot.long())
+    mixed = (robot_in_voxel > 0) & (robot_in_voxel < per_voxel)
+    rows.append({
+        "points": indices.shape[0],
+        "voxels": per_voxel.numel(),
+        "shared_points": int(shared.sum()),
+        "scene_points": int((~is_robot).sum()),
+        "scene_shared": int((shared & ~is_robot).sum()),
+        "robot_points": int(is_robot.sum()),
+        "robot_shared": int((shared & is_robot).sum()),
+        "mixed_voxels": int(mixed.sum()),
+        "max_per_voxel": int(per_voxel.max()),
+    })
+
+
+if __name__ == "__main__":
+    args = parse_args()
+    tester = Tester(args)
+    tester.model.dynamics_predictor.predictor_model.enc.enc0.block0.register_forward_pre_hook(count)
+    loader, _ = tester._build_eval_loader("test", enable_mask=False)
+    with torch.no_grad():
+        for i, batch in enumerate(loader):
+            if 0 < args.eval_num_batches <= i:
+                break
+            batch = {k: v.to(tester.device) if torch.is_tensor(v) else v for k, v in batch.items()}
+            tester.model(batch, training=False)
+
+    total = {k: sum(r[k] for r in rows) for k in rows[0] if k != "max_per_voxel"}
+    summary = {
+        "batches": len(rows),
+        "points": total["points"],
+        "shared_fraction": total["shared_points"] / total["points"],
+        "non_representative_fraction": (total["points"] - total["voxels"]) / total["points"],
+        "scene_shared_fraction": total["scene_shared"] / total["scene_points"],
+        "robot_shared_fraction": total["robot_shared"] / total["robot_points"],
+        "mixed_voxels_per_batch": total["mixed_voxels"] / len(rows),
+        "max_points_in_one_voxel": max(r["max_per_voxel"] for r in rows),
+    }
+    with open(os.environ.get("DUPSTATS_OUT", "duplicate_stats.json"), "w") as f:
+        json.dump({"summary": summary, "per_batch": rows}, f, indent=1)
+    print(json.dumps(summary, indent=1))
diff --git a/tests/forward_latency.py b/tests/forward_latency.py
new file mode 100644
index 0000000..116753b
--- /dev/null
+++ b/tests/forward_latency.py
@@ -0,0 +1,56 @@
+"""Time one PointWorld forward pass (DINOv3 + PTv3 + heads) per eval sample on the GPU.
+
+Takes the eval.py arguments. Batches are moved to the GPU before the clock starts, so
+data loading is excluded. The first $WARMUP batches (default 5) are dropped: they include
+torch.compile and kernel selection.
+
+    python tests/forward_latency.py --model_path ... --domains=droid --data_dirs=... \
+        --batch_size=1 --eval_num_batches=60
+"""
+
+import numba  # noqa: F401  (must load before torch on ROCm, see eval.py)
+
+import json
+import os
+import statistics
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import torch  # noqa: E402
+
+from arguments import parse_args  # noqa: E402
+from evaluation.tester import Tester  # noqa: E402
+
